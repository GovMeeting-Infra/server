# Database
DATABASE_URL=postgresql://govmeeting:devpass@localhost:5432/govmeeting_dev

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# BetterAuth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true
SESSION_INACTIVITY_TIMEOUT_SECONDS=1800
COOKIE_DOMAIN=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@ministry.gov.sl

# Image uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GDPR & Encryption
DATA_ENCRYPTION_KEY=
PII_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=2555

# Government Domain
GOVERNMENT_EMAIL_DOMAIN=.gov.sl
GOVERNMENT_EMAIL_STRICT=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# App
NODE_ENV=development
LOG_LEVEL=debug
APP_PORT=3000
APP_URL=http://localhost:3000

# Public URL of the web frontend — used to build scannable check-in links
WEB_URL=http://localhost:3000
