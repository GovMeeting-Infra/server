# Database
# Local dev (docker-compose):
DATABASE_URL=postgresql://govmeeting:devpass@localhost:5432/govmeeting_dev
# Production (Neon) — use the POOLED endpoint (`-pooler`) for the app:
#   DATABASE_URL=postgresql://user:pw@ep-xxx-pooler.REGION.aws.neon.tech/govmeeting?sslmode=require
# DIRECT endpoint, used only by `prisma migrate deploy`:
#   DIRECT_URL=postgresql://user:pw@ep-xxx.REGION.aws.neon.tech/govmeeting?sslmode=require

# Redis
# Local dev (docker-compose):
REDIS_URL=redis://localhost:6379
# Production (Upstash) — `rediss://` is required; credentials live in the URL,
# so leave REDIS_PASSWORD empty. Read by both the cache client and BullMQ.
#   REDIS_URL=rediss://default:PASSWORD@REGION-xxx-12345.upstash.io:6379
REDIS_PASSWORD=

# BetterAuth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true
SESSION_INACTIVITY_TIMEOUT_SECONDS=43200
COOKIE_DOMAIN=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@calendar.gov.sl

# Address the help page offers when someone is stuck. A shared mailbox that
# somebody actually reads — not a person, and deliberately not a roster entry.
# Blank sends people to their ministry administrator instead. A super admin can
# change this at /administrative/admin/settings without a redeploy; the stored
# value wins over this one.
SUPPORT_EMAIL=info@mocti.gov.sl

# Image uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Meeting transcription
# Audio is streamed through the API to the provider and never stored here.
# Only the text is saved, encrypted with DATA_ENCRYPTION_KEY below.
#
# deepgram (default) or openai. They differ in ways worth knowing:
#   deepgram  labels speakers, ~$0.30/hour, and stores nothing at all because
#             every stream is opened with mip_opt_out=true.
#   openai    no speaker labels, ~$1.02/hour, and OpenAI keeps request data up
#             to 30 days for abuse monitoring unless your organization has been
#             approved for zero data retention. Needs ffmpeg on the host: the
#             browser sends compressed audio and OpenAI only accepts raw PCM,
#             so the API converts it in memory (`apt install ffmpeg`).
TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# gpt-4o-transcribe-diarize labels speakers but refuses key terms;
# gpt-4o-transcribe takes key terms but labels nobody. Deepgram does
# both at once. Speaker labels win by default — a record of who decided
# what is worth more than the prompt.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
# Only if OpenAI moves the realtime endpoint. This default is the URL their
# own Node SDK builds, not the ?intent=transcription form in their guide.
# OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime?model=gpt-4o-transcribe-diarize
# Absolute path, if ffmpeg is not on PATH for the service user.
# FFMPEG_PATH=/usr/bin/ffmpeg
# Who drafts the minutes from the finished transcript: openai or
# anthropic. OpenAI by default, so transcription and drafting are one
# vendor, one key and one retention agreement.
MINUTES_DRAFT_PROVIDER=openai
MINUTES_DRAFT_MODEL=gpt-6-sol

# Comma-separated words to bias recognition toward: ministry names, officials,
# common Krio words. Neither provider has a Krio model; this is the main lever.
TRANSCRIPTION_KEYTERMS=
# Only needed if MINUTES_DRAFT_PROVIDER=anthropic. Ask Anthropic for zero data
# retention first if you switch the drafting over to Claude.
ANTHROPIC_API_KEY=

# GDPR & Encryption
DATA_ENCRYPTION_KEY=
PII_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=2555

# Government Domain
# Suffix required to sign in. A super admin can change this at
# /administrative/admin/settings; that override wins over this value.
# GOVERNMENT_EMAIL_STRICT and the RATE_LIMIT_* pair used to sit here and
# were read by nothing — rate limits come from @RateLimit() per route.
GOVERNMENT_EMAIL_DOMAIN=.gov.sl


# App
NODE_ENV=development
LOG_LEVEL=debug
# 3000 is Next.js; the API takes 4000. Must match the web app's
# INTERNAL_API_URL and the `upstream api` in nginx.conf.
APP_PORT=4000
APP_URL=http://localhost:4000

# Public URL of the web frontend — used to build scannable check-in links
WEB_URL=http://localhost:3000
